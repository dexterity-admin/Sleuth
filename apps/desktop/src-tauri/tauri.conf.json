{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sleuth",
  "identifier": "in.dexterity.sleuth",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sleuth",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Dexterity Design Services Pvt. Ltd.",
    "copyright": "Dexterity Design Services Pvt. Ltd.",
    "shortDescription": "Find any tag, in any drawing, on any drive",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sleuth-worker"
    ],
    "resources": {
      "../../../vendor/pdfium/bin/pdfium.dll": "pdfium.dll",
      "../../../vendor/models/pp-ocrv6_small_det.onnx": "models/pp-ocrv6_small_det.onnx",
      "../../../vendor/models/pp-ocrv6_small_rec.onnx": "models/pp-ocrv6_small_rec.onnx",
      "../../../vendor/models/ppocrv6_dict.txt": "models/ppocrv6_dict.txt",
      "../../../vendor/models/pp-lcnet_x1_0_textline_ori.onnx": "models/pp-lcnet_x1_0_textline_ori.onnx",
      "../../../vendor/libredwg/dwgread.exe": "libredwg/dwgread.exe",
      "../../../vendor/libredwg/libredwg-0.dll": "libredwg/libredwg-0.dll",
      "../../../vendor/libredwg/COPYING": "libredwg/COPYING",
      "../../../vendor/libredwg/SOURCE.txt": "libredwg/SOURCE.txt",
      "runtime/DirectML.dll": "DirectML.dll",
      "runtime/msvcp140.dll": "msvcp140.dll",
      "runtime/msvcp140_1.dll": "msvcp140_1.dll",
      "runtime/vcruntime140.dll": "vcruntime140.dll",
      "runtime/vcruntime140_1.dll": "vcruntime140_1.dll"
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      },
      "allowDowngrades": true
    }
  }
}